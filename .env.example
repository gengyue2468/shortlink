# server port
PORT=8787

# public url & api key
BASE_URL=http://localhost:8787
# Replace before starting; the example value is deliberately rejected
API_KEY=your-key

# optional: defaults to data/shortlinks.db
# DATABASE_PATH=/absolute/path/to/shortlinks.db

# umami
# UMAMI_URL=https://your-umami.example.com
# UMAMI_API_KEY=umami_your-api-key
# UMAMI_TIMEOUT_MS=2000

# Only enable behind a trusted proxy that overwrites incoming IP headers
TRUST_PROXY=false
